#!/usr/bin/env bash
# cf-tunnel-keepalive hook (rendered by cfbridge install-autostart).
# Keeps the cf-tunnel-bridge stack of ONE project alive:
#   - run/stopped present (cfbridge down / teardown) -> do nothing
#   - all managed units active + every service health ok -> silent
#   - otherwise reinstall units from the project's persistent systemd/
#     copies (container rebuilds wipe /etc), start the units that are
#     down in dependency order and restart only the service units whose
#     own health check fails; a healthy bridge/cloudflared is never
#     bounced, and repairs are throttled to one per 5 minutes
#   - still unhealthy -> doctor --fix, then wake the agent (throttled
#     to once per 30 min)
# proxy.env is refreshed each poll through `cfbridge sync-proxy`, which
# probes the proxy first: only a value that answers is ever written, so
# a stale variable in this environment cannot clobber a working entry.
# Credentials are written only into secrets/proxy.env (600), never
# logged. Local health probes never go through a proxy.
set -euo pipefail
source "$HATCH_HOOK_RUNTIME"

PROJ="{{PROJECT_DIR}}"
CFG="$PROJ/config.json"
UNITS_FILE="$PROJ/run/managed-units.txt"
CANON_DIR="$PROJ/systemd"
# Overridable only so the hook can be exercised in tests without /etc.
ETC_UNITS="${CFB_SYSTEMD_UNIT_DIR:-/etc/systemd/system}"

[[ -f "$CFG" ]] || { log "cf-tunnel: no config.json in project" '{}'; silent "project config missing"; }
# `cfbridge down` means down: restarting here would put the services
# back on the public internet behind the user's back.
[[ -f "$PROJ/run/stopped" ]] && silent "stack intentionally stopped (cfbridge down); run cfbridge up to resume"
[[ -f "$UNITS_FILE" ]] || silent "no managed units recorded yet (run cfbridge up first)"

mapfile -t UNITS < "$UNITS_FILE"
[[ ${#UNITS[@]} -gt 0 ]] || silent "managed units list empty"

# Recreate anything a container rebuild may have dropped. Without this
# the unit reinstall below has nothing to read from.
mkdir -p "$PROJ/logs" "$PROJ/run" "$PROJ/secrets"
chmod 700 "$PROJ/secrets" 2>/dev/null || true

CFB="{{SKILL_BIN}}/cfbridge.py"

# Enforce the log retention window on every poll. systemd appends raw
# stdout into logs/ on the only persistent volume, so without this a
# chatty service slowly fills $HOME and takes config.json/secrets with
# it. One CLI call, idempotent, silent unless something was done.
if [[ -f "$CFB" ]] && command -v python3 >/dev/null 2>&1; then
  python3 "$CFB" --project "$PROJ" prune-logs --quiet >/dev/null 2>&1 || true
fi

# --- refresh proxy.env (contains proxy creds; 600 only) ---
# Delegated to the CLI: it probes the environment's proxy and the one
# already in proxy.env (CFBRIDGE_PROXY first) and writes only a value
# that answers. Copying this environment blindly used to overwrite the
# one working entry with a rotated-away value, every minute.
if [[ -f "$CFB" ]] && command -v python3 >/dev/null 2>&1; then
  sync_out="$(python3 "$CFB" --project "$PROJ" sync-proxy --quiet 2>/dev/null || true)"
  if [[ "$sync_out" == *refreshed* ]]; then
    log "cf-tunnel: proxy.env refreshed" '{}'
  fi
fi

# Unit-name prefix of this project ("cfb-<slug>-"), taken from the
# cloudflared unit so service units can be matched to their services.
PREFIX=""
for u in "${UNITS[@]}"; do
  if [[ "$u" == *-cloudflared ]]; then PREFIX="${u%cloudflared}"; fi
done

# --- service health list: name, port, path, managed; separated by
# \x1f (a non-whitespace IFS character, so empty fields do not collapse)
# managed=1 when the service has a start_cmd (cfbridge runs it, so a
# restart can fix it); 0 for route-only services the user runs, which
# no restart of ours can fix. python3 is guaranteed present (the stack
# runs on it); jq is only a fallback.
svc_list() {
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$CFG" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        cfg = json.load(f)
except Exception:
    sys.exit(0)
for s in cfg.get("services") or []:
    port = s.get("port")
    if not port:
        continue
    managed = 1 if s.get("start_cmd") else 0
    print("\x1f".join([str(s.get("name") or ""), str(port), str(s.get("health") or "/health"), str(managed)]))
PY
  elif command -v jq >/dev/null 2>&1; then
    jq -r '.services[]? | select(.port) | "\(.name // "")\u001f\(.port)\u001f\(.health // "/health")\u001f\(if (.start_cmd // "") != "" then 1 else 0 end)"' "$CFG" 2>/dev/null || true
  fi
}

mapfile -t SVCS < <(svc_list || true)

# Loopback probe that never goes through a proxy: curl and urllib both
# honour http_proxy and neither exempts 127.0.0.1 by itself. Exit 2 =
# no probe tool available (health unknown, which is not "unhealthy").
probe_local() {
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl --noproxy '*' --fail --silent --max-time 5 -o /dev/null "$url" 2>/dev/null
    return $?
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$url" <<'PY' 2>/dev/null
import sys, urllib.request
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
try:
    with opener.open(sys.argv[1], timeout=5) as r:
        sys.exit(0 if 200 <= r.status < 400 else 1)
except Exception:
    sys.exit(1)
PY
    return $?
  fi
  return 2
}

# Fills DOWN_UNITS (managed units not active), BAD_SVC_UNITS (active
# service units whose own health check fails) and BAD_ROUTE (failing
# route-only services). Returns 0 only when all three are empty.
DOWN_UNITS=(); BAD_SVC_UNITS=(); BAD_ROUTE=()
assess() {
  local u line name port path managed rc unit
  DOWN_UNITS=(); BAD_SVC_UNITS=(); BAD_ROUTE=()
  for u in "${UNITS[@]}"; do
    systemctl is-active --quiet "$u" 2>/dev/null || DOWN_UNITS+=("$u")
  done
  # Every service must answer, not just the first one: otherwise a dead
  # second service stays dead while the hook keeps reporting healthy.
  for line in "${SVCS[@]}"; do
    [[ -n "$line" ]] || continue
    IFS=$'\x1f' read -r name port path managed <<<"$line"
    [[ -n "$port" ]] || continue
    rc=0
    probe_local "http://127.0.0.1:${port}${path}" || rc=$?
    [[ "$rc" == "0" || "$rc" == "2" ]] && continue
    unit="${PREFIX}svc-${name}"
    if [[ "$managed" == "1" && -n "$PREFIX" ]] && printf '%s\n' "${UNITS[@]}" | grep -qxF -- "$unit"; then
      # A unit that is down is already on DOWN_UNITS; only an active
      # but unhealthy one needs an explicit restart.
      printf '%s\n' "${DOWN_UNITS[@]}" | grep -qxF -- "$unit" || BAD_SVC_UNITS+=("$unit")
    else
      BAD_ROUTE+=("${name:-port $port}")
    fi
  done
  [[ ${#DOWN_UNITS[@]} -eq 0 && ${#BAD_SVC_UNITS[@]} -eq 0 && ${#BAD_ROUTE[@]} -eq 0 ]]
}

healthy() { assess; }

if assess; then
  silent "cf tunnel stack healthy (${#UNITS[@]} units, ${#SVCS[@]} services)"
fi

# Route-only services are the user's processes: nothing we restart can
# fix them, so they alone never trigger a repair (only the wake below).
if [[ ${#DOWN_UNITS[@]} -eq 0 && ${#BAD_SVC_UNITS[@]} -eq 0 ]]; then
  repair_needed=0
else
  repair_needed=1
fi

# Repair throttle: a stack that cannot come up must not be hammered
# with restarts every minute (each one drops live connections).
RESTART_STAMP="$PROJ/run/hook-last-repair"
throttled_repair=0
if [[ "$repair_needed" == "1" && -f "$RESTART_STAMP" ]]; then
  now_s="$(date +%s)"
  last_repair="$(cat "$RESTART_STAMP" 2>/dev/null || echo 0)"
  if [[ "$last_repair" =~ ^[0-9]+$ ]] && (( now_s - last_repair < 300 )); then
    throttled_repair=1
  fi
fi

missing_canon=0
if [[ "$repair_needed" == "1" && "$throttled_repair" == "0" ]]; then
  date +%s > "$RESTART_STAMP" 2>/dev/null || true
  log "cf-tunnel: stack unhealthy, reinstalling units and starting what is down" '{}'
  for u in "${UNITS[@]}"; do
    if [[ -f "$CANON_DIR/$u.service" ]]; then
      if ! cmp -s "$CANON_DIR/$u.service" "$ETC_UNITS/$u.service" 2>/dev/null; then
        cp -f "$CANON_DIR/$u.service" "$ETC_UNITS/$u.service"
        chmod 644 "$ETC_UNITS/$u.service" 2>/dev/null || true
      fi
    else
      missing_canon=1
    fi
    systemctl enable --quiet "$u" 2>/dev/null || true
  done
  systemctl daemon-reload || true
  # Dependency order: bridge -> services -> cloudflared. Only units that
  # are down get started; an active bridge/cloudflared is left alone.
  ordered=()
  for u in "${DOWN_UNITS[@]}"; do
    if [[ "$u" == *-bridge ]]; then ordered+=("$u"); fi
  done
  for u in "${DOWN_UNITS[@]}"; do
    if [[ "$u" != *-bridge && "$u" != *-cloudflared ]]; then ordered+=("$u"); fi
  done
  for u in "${DOWN_UNITS[@]}"; do
    if [[ "$u" == *-cloudflared ]]; then ordered+=("$u"); fi
  done
  for u in "${ordered[@]}"; do
    systemctl reset-failed "$u" 2>/dev/null || true
    systemctl start "$u" || true
    if [[ "$u" == *-bridge ]]; then sleep 2; fi
  done
  for u in "${BAD_SVC_UNITS[@]}"; do
    systemctl restart "$u" || true
  done
fi

recovered=0
if [[ "$repair_needed" == "1" && "$throttled_repair" == "0" ]]; then
  for _ in $(seq 1 15); do
    sleep 3
    if healthy; then
      recovered=1
      break
    fi
  done
fi
if [[ "$recovered" == "1" ]]; then
  log "cf-tunnel: stack recovered after reinstall" '{}'
  silent "cf tunnel stack was unhealthy and has been reinstalled/restarted; healthy now"
fi
if [[ "$throttled_repair" == "1" ]]; then
  silent "cf tunnel stack unhealthy; last repair < 5 min ago (restart throttled)"
fi

if [[ "$repair_needed" == "1" ]]; then
  log "cf-tunnel: stack still unhealthy after reinstall attempt" '{}'
else
  log "cf-tunnel: route-only service(s) unhealthy; their processes are not managed here" '{}'
fi
if [[ "$missing_canon" == "1" ]]; then
  log "cf-tunnel: canonical units missing under $CANON_DIR" '{}'
fi

# Last resort before waking the agent: let the CLI repair its own
# dependencies. Reinstalling units only fixes a wiped /etc; a lost
# venv, a missing cloudflared copy, a rotated proxy.env value or a
# bridge port taken by another project all leave units installed and
# crash-looping. doctor --fix covers those and starts what is down.
if [[ "$repair_needed" == "1" && -f "$CFB" ]]; then
  fix_log="$PROJ/logs/last-doctor-fix.log"
  if python3 "$CFB" --project "$PROJ" doctor --fix >"$fix_log" 2>&1; then
    :  # exit 0 = every required dependency is satisfied
  else
    # A non-zero exit still writes the full report; it just means some
    # dependency is beyond repair from here (no root, no proxy, ...).
    true
  fi
  if healthy; then
    log "cf-tunnel: stack recovered via doctor --fix (see logs/last-doctor-fix.log)" '{}'
    silent "cf tunnel stack was unhealthy; cfbridge doctor --fix repaired it"
  fi
fi

# Wake throttling needs jq (hook_state_get returns JSON). Without it we
# still wake, just without the throttle — better noisy than silent-dead.
throttled=0
if command -v jq >/dev/null 2>&1; then
  now_s="$(date +%s)"
  last_wake="$(hook_state_get | jq -r '.last_wake_epoch // 0' 2>/dev/null || echo 0)"
  if [[ "$now_s" =~ ^[0-9]+$ ]] && [[ "$last_wake" =~ ^[0-9]+$ ]] && (( now_s - last_wake < 1800 )); then
    throttled=1
  else
    hook_state_set "$(jq -cn --argjson t "$now_s" '{last_wake_epoch: $t}')" || true
  fi
fi
if [[ "$throttled" == "1" ]]; then
  silent "cf tunnel stack still unhealthy after reinstall (wake throttled)"
fi
wake "cf tunnel stack unhealthy after auto-reinstall" \
     "{\"project\":\"$PROJ\",\"action\":\"investigate cf-tunnel-bridge stack\"}"
silent "cf tunnel stack still unhealthy after reinstall; agent woken"
